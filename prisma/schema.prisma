generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Url {
  id          BigInt   @id @default(autoincrement())
  shortId     String?  @unique
  redirectURL String
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
}